                    })
            },


            async deleteKra(id) {
                await axios
                    .get(this.api_url + "kra_delete/" + id, {
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: this.token ? `Bearer ${this.token}` : ""
                        },
                    })
                    .then((data) => {
                        this.$toasted.show(data.data.message, {
                            theme: "bubble",
                            duration: 5000,
                            position: "bottom-right",
                        });
                        this.getItems();
                        console.log(data);
                    })

            },
            async delete_kra(id) {
                this.$swal({
                    title: "Are you sure you want to delete?",
                    text: '',
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                })
                    .then((willDelete) => {
                        if (willDelete) {
                            this.deleteKra(id)
                        }
                    })
            },
            async delete_kpi(id) {
                this.$swal({
                    title: "Are you sure you want to delete?",
