                    },
                })
                    .then((data) => {
                        this.$toasted.show(data.data.message, {
                            theme: "bubble",
                            duration: 5000,
                            position: "bottom-right",
                        });

                        //HIDE MODAL
                        this.$modal.hide("mosedit");

                        //DATA RELOAD
